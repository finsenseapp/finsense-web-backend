DATABASE_URL="postgresql://postgres:admin123@localhost:5432/finsense_db?schema=public"
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-random-64-byte-hex
JWT_EXPIRES_IN=7d
APP_TIMEZONE=Asia/Colombo
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: a faster, lighter model for the chatbot (falls back to GEMINI_MODEL)
GEMINI_CHAT_MODEL=
# Where receipts are stored (a folder outside any web root; default: backend/uploads)
UPLOAD_DIR=uploads
# Number of proxies in front of the server (0 locally; 2 when hosted behind Vercel + Render)
TRUST_PROXY=0
# Optional: used automatically when the model above is out of quota or unavailable (a different model has its own quota)
GEMINI_FALLBACK_MODEL=
